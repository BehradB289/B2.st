# ==============================================================================
# B2.st Security Studio - Mario Web Engine Environment Configuration Blueprint
# ==============================================================================
# نکته امنیتی: تمام مقادیر تولید (Production) باید خارج از سورس‌کد تزریق شوند.
# ==============================================================================

# هسته سرور
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# سیاست‌های کنترل دسترسی و ترافیک
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# پیکربندی امنیتی بازی
SESSION_SECRET=super_secret_entropy_minimum_32_chars_long_passphrase_here
ENABLE_CSP_REPORT_ONLY=false
ASSETS_CACHE_MAX_AGE_SEC=86400

# لاگین و دیباگ
LOG_LEVEL=info
DEBUG_METRICS=false