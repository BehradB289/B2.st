# ==============================================================================
# STUDIO B2.ST - HARDENED ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure specific values.
# DO NOT COMMIT REAL CREDENTIALS/SECRETS TO VERSION CONTROL.
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Security & Network Headers
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ENABLE_CSP_REPORT_ONLY=false

# Rate Limiting Configuration (DDoS / Brute Force Mitigation)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Game Runtime & Assets Storage
STATIC_ASSETS_DIR=public
ENABLE_GAME_TELEMETRY=false
DEBUG_COLLISION_BOXES=false