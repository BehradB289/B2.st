```bash
# ============================================
# B2.st Studio - Mario Game Environment Config
# ============================================
# این فایل را کپی کرده و نام آن را .env بگذارید
# cp .env.example .env

# ──────────── General ────────────
NODE_ENV=development
APP_NAME=mario-game-b2st
APP_VERSION=1.0.0
APP_PORT=8080
APP_HOST=localhost

# ──────────── Game Settings ────────────
GAME_CANVAS_WIDTH=768
GAME_CANVAS_HEIGHT=720
GAME_FPS=60
GAME_GRAVITY=0.7
GAME_FRICTION=0.8
GAME_DEBUG_MODE=false
GAME_SHOW_FPS=false
GAME_SHOW_HITBOX=false
GAME_MUTE_AUDIO=false
GAME_MASTER_VOLUME=0.7
GAME_INITIAL_LIVES=3
GAME_MAX_LEVEL=8
GAME_TILE_SIZE=16
GAME_SCALE_FACTOR=2

# ──────────── Player Physics ────────────
PLAYER_SPEED=3.5
PLAYER_JUMP_FORCE=-12
PLAYER_MAX_FALL_SPEED=8
PLAYER_ACCELERATION=0.5
PLAYER_DECELERATION=0.3
PLAYER_INVINCIBILITY_DURATION=2000

# ──────────── Asset Paths ────────────
ASSETS_BASE_PATH=./assets
ASSETS_SPRITES_PATH=./assets/sprites
ASSETS_AUDIO_PATH=./assets/audio
ASSETS_LEVELS_PATH=./assets/levels
ASSETS_FONTS_PATH=./assets/fonts

# ──────────── Security ────────────
SECURITY_CSP_ENABLED=true
SECURITY_CORS_ORIGIN=*
SECURITY_RATE_LIMIT=100
SECURITY_XSS_PROTECTION=true

# ──────────── Analytics (Optional) ────────────
ANALYTICS_ENABLED=false
ANALYTICS_TRACKING_ID=
ANALYTICS_ENDPOINT=

# ──────────── Build ────────────
BUILD_MINIFY=true
BUILD_SOURCEMAP=false
BUILD_OUTPUT_DIR=./dist
BUILD_CACHE_BUST=true
```