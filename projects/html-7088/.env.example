```env
# ============================================
# B2.st Studio - Mario Game Environment Config
# ============================================
# این فایل را کپی کنید به .env و مقادیر را تنظیم کنید
# cp .env.example .env

# ---------- Server ----------
PORT=3000
HOST=localhost
NODE_ENV=production

# ---------- Game Settings ----------
GAME_TITLE=Super Mario Bros
GAME_VERSION=1.0.0
GAME_DEBUG_MODE=false
GAME_FPS=60
GAME_CANVAS_WIDTH=800
GAME_CANVAS_HEIGHT=600

# ---------- Audio ----------
AUDIO_ENABLED=true
AUDIO_VOLUME=0.7

# ---------- Security ----------
ALLOWED_ORIGINS=http://localhost:3000,https://b2.st
CSP_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ---------- Analytics (Optional) ----------
ANALYTICS_ENABLED=false
ANALYTICS_ENDPOINT=

# ---------- High Score API (Optional) ----------
HIGHSCORE_API_URL=
HIGHSCORE_API_KEY=
```