{
  "openapi": "3.0.3",
  "info": {
    "title": "B2.st Studio Super Mario Engine API",
    "description": "مستندات تعاملی و جامع API موتور بازی سوپر ماریو (B2.st Canvas Engine). این سرویس وظیفه بارگذاری استریمینگ مراحل (Tilemap)، مدیریت نشست‌های بازی، همگام‌سازی تله‌متری فیزیک AABB، جدول برترین امتیازها (Leaderboard)، ذخیره‌سازی وضعیت ECS و رجیستری دارایی‌های صوتی و تصویری را بر عهده دارد.",
    "version": "1.2.0",
    "contact": {
      "name": "B2.st Studio Core Game Team",
      "email": "dev@b2.st",
      "url": "https://b2.st"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "گیت‌وی محلی بازی (Local Mario Engine Host)"
    },
    {
      "url": "https://mario.b2.st/api/v1",
      "description": "سرور توزیع‌شده ابری استودیو B2.st"
    }
  ],
  "tags": [
    {
      "name": "System & Health",
      "description": "بررسی وضعیت اتصال سرور و متریک‌های چرخه‌حیات موتور"
    },
    {
      "name": "Level Streaming",
      "description": "دریافت اطلاعات ماتریس تایل‌مپ، مختصات موجودیت‌ها و تنظیمات گرانش"
    },
    {
      "name": "Game Sessions",
      "description": "مدیریت نشست، همگام‌سازی پوزیشن فیزیکی ماریو و ثبت رویدادهای کنترلی"
    },
    {
      "name": "Leaderboard",
      "description": "ثبت رکوردهای امتیازی با اعتبارسنجی ضد تقلب و نمایش جدول برترین‌ها"
    },
    {
      "name": "Save States",
      "description": "سریال‌سازی و بازگردانی وضعیت کل موجودیت‌های ECS بازی"
    },
    {
      "name": "Assets",
      "description": "کاتالوگ اطلس اسپریت‌ها و بافرهای صوتی کلاسیک NES"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System & Health"],
        "summary": "وضعیت سلامت موتور و سرور بازی",
        "description": "اطلاعات مربوط به آپ‌تایم، فریم‌ریت پیش‌فرض (Target FPS) و وضعیت ماژول‌های ECS را برمی‌گرداند.",
        "responses": {
          "200": {
            "description": "سیستم فعال و آماده خدمت‌رسانی است",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/levels": {
      "get": {
        "tags": ["Level Streaming"],
        "summary": "فهرست مراحل در دسترس",
        "description": "دریافت متادیتای تمام مراحل قابل بارگذاری در انجین به همراه تم و طول برحسب تایل.",
        "responses": {
          "200": {
            "description": "لیست مراحل با موفقیت بازیابی شد",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LevelSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/levels/{levelId}": {
      "get": {
        "tags": ["Level Streaming"],
        "summary": "دریافت جزییات ساختاری و تایل‌مپ یک مرحله",
        "description": "ارائه مپ دوبعدی تایل‌ها، نقاط اسپاون، سالید بلاک‌ها، لوله‌های تعاملی و انمی‌های اولیه.",
        "parameters": [
          {
            "name": "levelId",
            "in": "path",
            "required": true,
            "description": "شناسه مرحله (مثلاً world-1-1)",
            "schema": {
              "type": "string",
              "example": "world-1-1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "داده‌های کامل مرحله تحویل داده شد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevelDetail"
                }
              }
            }
          },
          "404": {
            "description": "مرحله مورد نظر یافت نشد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/session/start": {
      "post": {
        "tags": ["Game Sessions"],
        "summary": "شروع نشست بازی جدید",
        "description": "ایجاد یک Session ID یونیک برای ارزیابی فیزیک، شمارش تیک‌های حلقه بازی و پیگیری رویدادها.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionStartRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "نشست بازی با موفقیت ایجاد شد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/session/{sessionId}/state": {
      "get": {
        "tags": ["Game Sessions"],
        "summary": "دریافت آخرین وضعیت تله‌متری فیزیک و ECS ماریو",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "وضعیت فیزیک و موجودیت‌ها بازیابی شد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStateUpdate"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Game Sessions"],
        "summary": "به‌روزرسانی دوره‌ای فیزیک و وضعیت ماریو از سمت کلاینت",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionStateUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "وضعیت با موفقیت سینک شد"
          }
        }
      }
    },
    "/session/{sessionId}/events": {
      "post": {
        "tags": ["Game Sessions"],
        "summary": "ثبت رویداد ورودی یا تعامل فیزیکی (پرش، برخورد، جمع‌آوری سکه)",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionEvent"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "رویداد دریافت و در پایپ‌لاین فیزیک پردازش شد"
          }
        }
      }
    },
    "/leaderboard": {
      "get": {
        "tags": ["Leaderboard"],
        "summary": "دریافت برترین رکوردهای ثبت‌شده ماریو",
        "parameters": [
          {
            "name": "levelId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "world-1-1"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "فهرست رتبه‌بندی بازیکنان",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeaderboardEntry"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Leaderboard"],
        "summary": "ثبت رکورد جدید پس از اتمام یا فوت مرحله",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaderboardSubmission"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "رکورد بررسی، اعتبارسنجی و ثبت گردید"
          },
          "400": {
            "description": "عدم تطابق چک‌سام فیزیک یا خطای تقلب",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/savegame/save": {
      "post": {
        "tags": ["Save States"],
        "summary": "ذخیره اسنپ‌شات کامل از موتور بازی در دیتابیس محلی یا ابری",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveGamePayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "اسنپ‌شات با موفقیت پایدارسازی شد"
          }
        }
      }
    },
    "/savegame/load/{saveId}": {
      "get": {
        "tags": ["Save States"],
        "summary": "بازیابی اسنپ‌شات ذخیره‌شده بازی بر مبنای شناسه",
        "parameters": [
          {
            "name": "saveId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "داده‌های اسنپ‌شات وضعیت بازیابی شد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveGamePayload"
                }
              }
            }
          }
        }
      }
    },
    "/assets/manifest": {
      "get": {
        "tags": ["Assets"],
        "summary": "دریافت کاتالوگ منابع گرافیکی، مختصات اطلس اسپریت‌ها و بافرهای صدا",
        "responses": {
          "200": {
            "description": "مانیفست کامل دارایی‌های استودیو B2.st",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetManifest"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Engine-Key",
        "description": "کلید اختصاصی انجین استودیو B2.st جهت دسترسی به تله‌متری و ذخیره‌سازی"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "RUNNING"
          },
          "version": {
            "type": "string",
            "example": "1.2.0"
          },
          "engineFps": {
            "type": "integer",
            "example": 60
          },
          "activeSessions": {
            "type": "integer",
            "example": 4
          },
          "physicsEngine": {
            "type": "string",
            "example": "B2-AABB-Continuous-v1"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Vector2D": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "x": {
            "type": "number",
            "format": "float",
            "example": 128.5
          },
          "y": {
            "type": "number",
            "format": "float",
            "example": 384.0
          }
        }
      },
      "AABBBox": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "type": "number", "example": 120.0 },
          "y": { "type": "number", "example": 380.0 },
          "width": { "type": "number", "example": 16.0 },
          "height": { "type": "number", "example": 16.0 }
        }
      },
      "MarioForm": {
        "type": "string",
        "enum": ["SMALL", "SUPER", "FIRE", "STAR_POWER"],
        "example": "SMALL"
      },
      "MarioState": {
        "type": "object",
        "required": ["position", "velocity", "form", "lives", "score", "coins", "isGrounded"],
        "properties": {
          "position": {
            "$ref": "#/components/schemas/Vector2D"
          },
          "velocity": {
            "$ref": "#/components/schemas/Vector2D"
          },
          "form": {
            "$ref": "#/components/schemas/MarioForm"
          },
          "lives": {
            "type": "integer",
            "example": 3
          },
          "score": {
            "type": "integer",
            "example": 1250
          },
          "coins": {
            "type": "integer",
            "example": 14
          },
          "isGrounded": {
            "type": "boolean",
            "example": true
          },
          "isFacingRight": {
            "type": "boolean",
            "example": true
          },
          "invincibleTimer": {
            "type": "number",
            "example": 0.0
          }
        }
      },
      "EntitySnapshot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "goomba-004"
          },
          "type": {
            "type": "string",
            "enum": ["GOOMBA", "KOOPA", "COIN", "MUSHROOM", "FIRE_FLOWER", "STAR"],
            "example": "GOOMBA"
          },
          "position": {
            "$ref": "#/components/schemas/Vector2D"
          },
          "velocity": {
            "$ref": "#/components/schemas/Vector2D"
          },
          "alive": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "LevelSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "world-1-1"
          },
          "name": {
            "type": "string",
            "example": "World 1-1 (Classic Plains)"
          },
          "theme": {
            "type": "string",
            "enum": ["OVERWORLD", "UNDERGROUND", "CASTLE", "UNDERWATER"],
            "example": "OVERWORLD"
          },
          "widthTiles": {
            "type": "integer",
            "example": 224
          },
          "heightTiles": {
            "type": "integer",
            "example": 15
          },
          "timeLimit": {
            "type": "integer",
            "example": 400
          }
        }
      },
      "LevelDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "world-1-1" },
          "name": { "type": "string", "example": "World 1-1" },
          "tileSize": { "type": "integer", "example": 16 },
          "gravity": { "type": "number", "example": 0.55 },
          "backgroundColor": { "type": "string", "example": "#5c94fc" },
          "playerSpawn": {
            "$ref": "#/components/schemas/Vector2D"
          },
          "matrix": {
            "type": "array",
            "description": "ماتریس دوبعدی شماره آی‌دی تایل‌ها برای لایه سالید و بک‌گراند",
            "items": {
              "type": "array",
              "items": { "type": "integer" }
            }
          },
          "initialEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntitySnapshot"
            }
          }
        }
      },
      "SessionStartRequest": {
        "type": "object",
        "required": ["levelId", "playerName"],
        "properties": {
          "levelId": { "type": "string", "example": "world-1-1" },
          "playerName": { "type": "string", "example": "B2_Gamer" },
          "retroShaderEnabled": { "type": "boolean", "default": true }
        }
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string", "format": "uuid", "example": "a1b2c3d4-e5f6-4789-abcd-0123456789ab" },
          "levelId": { "type": "string", "example": "world-1-1" },
          "createdAt": { "type": "string", "format": "date-time" },
          "initialState": { "$ref": "#/components/schemas/MarioState" }
        }
      },
      "SessionStateUpdate": {
        "type": "object",
        "properties": {
          "tick": { "type": "integer", "example": 1420 },
          "cameraOffset": { "type": "number", "example": 320.0 },
          "mario": { "$ref": "#/components/schemas/MarioState" },
          "activeEntities": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EntitySnapshot" }
          }
        }
      },
      "SessionEvent": {
        "type": "object",
        "required": ["eventType", "tick", "details"],
        "properties": {
          "eventType": {
            "type": "string",
            "enum": ["JUMP", "STOMP_ENEMY", "COLLECT_COIN", "BREAK_BRICK", "POWER_UP", "DEATH", "FLAGPOLE_TOUCH"],
            "example": "STOMP_ENEMY"
          },
          "tick": { "type": "integer", "example": 1420 },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "example": { "enemyId": "goomba-002", "pointsAwarded": 100 }
          }
        }
      },
      "LeaderboardEntry": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer", "example": 1 },
          "playerName": { "type": "string", "example": "MarioMaster_B2" },
          "score": { "type": "integer", "example": 98450 },
          "coins": { "type": "integer", "example": 68 },
          "clearTimeSeconds": { "type": "number", "example": 128.4 },
          "levelId": { "type": "string", "example": "world-1-1" },
          "achievedAt": { "type": "string", "format": "date-time" }
        }
      },
      "LeaderboardSubmission": {
        "type": "object",
        "required": ["sessionId", "playerName", "score", "coins", "clearTimeSeconds", "replayChecksum"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "playerName": { "type": "string", "example": "B2_Champion" },
          "score": { "type": "integer", "example": 45600 },
          "coins": { "type": "integer", "example": 25 },
          "clearTimeSeconds": { "type": "number", "example": 194.2 },
          "replayChecksum": { "type": "string", "example": "sha256-e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }
        }
      },
      "SaveGamePayload": {
        "type": "object",
        "required": ["saveId", "timestamp", "levelId", "marioState"],
        "properties": {
          "saveId": { "type": "string", "example": "slot-1" },
          "timestamp": { "type": "string", "format": "date-time" },
          "levelId": { "type": "string", "example": "world-1-1" },
          "cameraX": { "type": "number", "example": 480.0 },
          "marioState": { "$ref": "#/components/schemas/MarioState" },
          "eliminatedEntityIds": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["goomba-001", "goomba-002", "coin-block-014"]
          }
        }
      },
      "AssetManifest": {
        "type": "object",
        "properties": {
          "spriteSheetUrl": { "type": "string", "example": "/assets/sprites/mario-tileset.png" },
          "spriteWidth": { "type": "integer", "example": 16 },
          "spriteHeight": { "type": "integer", "example": 16 },
          "frames": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AABBBox"
            }
          },
          "audioTracks": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "example": {
              "theme_overworld": "/assets/audio/overworld.ogg",
              "jump_small": "/assets/audio/jump-small.wav",
              "coin": "/assets/audio/coin.wav",
              "powerup": "/assets/audio/powerup.wav",
              "die": "/assets/audio/die.wav"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "LEVEL_NOT_FOUND" },
          "message": { "type": "string", "example": "مرحله با شناسه مشخص شده در پایگاه داده انجین یافت نشد." },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}