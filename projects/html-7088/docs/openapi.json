{
  "openapi": "3.0.3",
  "info": {
    "title": "Super Mario Canvas Engine & Cloud API",
    "description": "مستندات تعاملی وب‌سرویس‌های استودیو B2.st برای بازی سوپر ماریو، شامل مدیریت جدول امتیازات، ذخیره‌سازی وضعیت بازی در فضای ابری، پیکربندی مراحل و تله‌متری چرخه گیم‌پلی.",
    "version": "1.0.0",
    "contact": {
      "name": "B2.st Studio Platform Team",
      "url": "https://b2.st",
      "email": "engineering@b2.st"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "محیط محلی توسعه (Local Development Engine)"
    },
    {
      "url": "https://mario-api.b2.st",
      "description": "سرور عملیاتی استودیو (Studio B2.st Production Cloud)"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "پایش سلامت سرویس و متریال‌های هسته موتور فیزیک"
    },
    {
      "name": "Leaderboard",
      "description": "ثبت رکوردهای بازی، اعتبارسنجی چکسام و نمایش جدول برترین‌ها"
    },
    {
      "name": "Levels",
      "description": "دریافت هندسه تایل‌مپ، مختصات دشمنان و پیکربندی مراحل"
    },
    {
      "name": "Game Saves",
      "description": "ذخیره و بازیابی وضعیت ماریو (جان، وضعیت سوپر، سکه‌ها، چک‌پوینت)"
    },
    {
      "name": "Telemetry",
      "description": "ارسال رویدادهای تحلیلی گیم‌پلی نظیر پرش، استامپ، مرگ و سقوط"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["System"],
        "summary": "بررسی سلامت سرویس و موتور بازی",
        "description": "دریافت وضعیت زنده سرویس، نسخه موتور فیزیک، میزان فریم و زمان فعالیت سیستم.",
        "operationId": "getHealthStatus",
        "responses": {
          "200": {
            "description": "سرویس فعال و پایدار است",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/leaderboard": {
      "get": {
        "tags": ["Leaderboard"],
        "summary": "دریافت برترین رکوردهای بازیکنان",
        "description": "لیست رتبه‌بندی شده بازیکنان با فیلتر بازه زمانی و صفحه‌بندی.",
        "operationId": "getLeaderboard",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "تعداد رکوردها در پاسخ",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "levelId",
            "in": "query",
            "description": "شناسه مرحله مورد نظر",
            "required": false,
            "schema": {
              "type": "string",
              "default": "world-1-1"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "description": "بازه زمانی رکوردها",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["all_time", "monthly", "weekly"],
              "default": "all_time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "جدول رتبه‌بندی با موفقیت دریافت شد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Leaderboard"],
        "summary": "ثبت رکورد جدید در جدول امتیازات",
        "description": "ارسال نتیجه دور بازی بازیکن همراه با چکسام اعتبارسنجی جهت جلوگیری از دستکاری نتایج.",
        "operationId": "submitScore",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreSubmission"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "رکورد با موفقیت ثبت گردید",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardEntry"
                }
              }
            }
          },
          "400": {
            "description": "داده‌های ارسالی یا چکسام نامعتبر است",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/levels/{levelId}": {
      "get": {
        "tags": ["Levels"],
        "summary": "دریافت ساختار و چینش مرحله",
        "description": "دریافت آرایه تایل‌مپ، موقعیت دشمنان و زمان مرحله جهت بارگذاری پویا در موتور بازی.",
        "operationId": "getLevelData",
        "parameters": [
          {
            "name": "levelId",
            "in": "path",
            "required": true,
            "description": "شناسه یکتای مرحله (مثال: world-1-1)",
            "schema": {
              "type": "string",
              "example": "world-1-1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "پیکربندی مرحله آماده بارگذاری است",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevelData"
                }
              }
            }
          },
          "404": {
            "description": "مرحله مورد نظر یافت نشد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/saves": {
      "post": {
        "tags": ["Game Saves"],
        "summary": "ذخیره وضعیت بازی در کلود",
        "description": "ثبت وضعیت کاراکتر ماریو در هنگام رسیدن به چک‌پوینت یا ذخیره دستی.",
        "operationId": "saveGameState",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveGameRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "وضعیت با موفقیت ذخیره شد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveGameResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/saves/{playerId}": {
      "get": {
        "tags": ["Game Saves"],
        "summary": "بارگذاری آخرین وضعیت ذخیره‌شده بازیکن",
        "description": "دریافت اطلاعات آخرین ذخیره بازیکن بر اساس شناسه کاربری جهت ادامه بازی.",
        "operationId": "getSaveGame",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "description": "شناسه کاربری بازیکن",
            "schema": {
              "type": "string",
              "example": "player_b2_01"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "وضعیت ذخیره‌شده بازی دریافت شد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveGameResponse"
                }
              }
            }
          },
          "404": {
            "description": "هیچ فایل ذخیره‌ای برای این بازیکن یافت نشد",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/telemetry/events": {
      "post": {
        "tags": ["Telemetry"],
        "summary": "ارسال بسته‌ای از وقایع درون بازی (Telemetry Batch)",
        "description": "ارسال تجمیعی لاگ‌های پرش، له کردن دشمنان، افتادن در چاله و دریافت سکه‌ها.",
        "operationId": "postTelemetryBatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryBatch"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "رویدادها با موفقیت برای پردازش در صف قرار گرفتند",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acceptedEvents": {
                      "type": "integer",
                      "example": 5
                    },
                    "status": {
                      "type": "string",
                      "example": "QUEUED"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "required": ["status", "engine", "version", "uptimeSeconds", "fpsTarget"],
        "properties": {
          "status": {
            "type": "string",
            "example": "HEALTHY"
          },
          "engine": {
            "type": "string",
            "example": "B2.st Mario Canvas 2D"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 14280.5
          },
          "fpsTarget": {
            "type": "integer",
            "example": 60
          }
        }
      },
      "LeaderboardEntry": {
        "type": "object",
        "required": ["id", "rank", "playerName", "score", "coins", "timeRemaining", "levelId", "submittedAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "d3b07384-d113-4f9e-b9bb-2fe49842f1f0"
          },
          "rank": {
            "type": "integer",
            "example": 1
          },
          "playerName": {
            "type": "string",
            "example": "MarioMaster99"
          },
          "score": {
            "type": "integer",
            "example": 38450
          },
          "coins": {
            "type": "integer",
            "example": 42
          },
          "timeRemaining": {
            "type": "integer",
            "example": 284
          },
          "levelId": {
            "type": "string",
            "example": "world-1-1"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-05-10T14:32:00Z"
          }
        }
      },
      "LeaderboardResponse": {
        "type": "object",
        "required": ["total", "levelId", "entries"],
        "properties": {
          "total": {
            "type": "integer",
            "example": 128
          },
          "levelId": {
            "type": "string",
            "example": "world-1-1"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeaderboardEntry"
            }
          }
        }
      },
      "ScoreSubmission": {
        "type": "object",
        "required": ["playerName", "score", "coins", "timeRemaining", "levelId", "checksum"],
        "properties": {
          "playerName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "example": "RetroGamer"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "example": 42500
          },
          "coins": {
            "type": "integer",
            "minimum": 0,
            "example": 36
          },
          "timeRemaining": {
            "type": "integer",
            "minimum": 0,
            "maximum": 400,
            "example": 275
          },
          "levelId": {
            "type": "string",
            "example": "world-1-1"
          },
          "checksum": {
            "type": "string",
            "description": "SHA-256 یا کلید هش تولید شده توسط ران‌تایم بازی جهت تضمین عدم تقلب",
            "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          }
        }
      },
      "LevelData": {
        "type": "object",
        "required": ["levelId", "widthInTiles", "heightInTiles", "timeLimit", "marioSpawn", "enemySpawns"],
        "properties": {
          "levelId": {
            "type": "string",
            "example": "world-1-1"
          },
          "widthInTiles": {
            "type": "integer",
            "example": 212
          },
          "heightInTiles": {
            "type": "integer",
            "example": 15
          },
          "timeLimit": {
            "type": "integer",
            "example": 400
          },
          "marioSpawn": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "example": 40 },
              "y": { "type": "number", "example": 192 }
            }
          },
          "enemySpawns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "example": "goomba" },
                "x": { "type": "number", "example": 352 },
                "y": { "type": "number", "example": 192 }
              }
            }
          }
        }
      },
      "SaveGameRequest": {
        "type": "object",
        "required": ["playerId", "levelId", "lives", "score", "coins", "isSuper", "checkpointX"],
        "properties": {
          "playerId": {
            "type": "string",
            "example": "player_b2_01"
          },
          "levelId": {
            "type": "string",
            "example": "world-1-1"
          },
          "lives": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "example": 3
          },
          "score": {
            "type": "integer",
            "example": 12400
          },
          "coins": {
            "type": "integer",
            "example": 18
          },
          "isSuper": {
            "type": "boolean",
            "example": true
          },
          "checkpointX": {
            "type": "number",
            "example": 1120.5
          }
        }
      },
      "SaveGameResponse": {
        "type": "object",
        "required": ["saveId", "playerId", "savedAt", "data"],
        "properties": {
          "saveId": {
            "type": "string",
            "format": "uuid",
            "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
          },
          "playerId": {
            "type": "string",
            "example": "player_b2_01"
          },
          "savedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-05-10T15:20:00Z"
          },
          "data": {
            "$ref": "#/components/schemas/SaveGameRequest"
          }
        }
      },
      "TelemetryEvent": {
        "type": "object",
        "required": ["type", "timestamp", "position"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["JUMP", "STOMP_ENEMY", "COLLECT_COIN", "POWERUP_MUSHROOM", "MARIO_DEATH", "FLAGPOLE_REACHED"],
            "example": "STOMP_ENEMY"
          },
          "timestamp": {
            "type": "integer",
            "description": "زمان یونیکس بر حسب میلی‌ثانیه",
            "example": 1715349120000
          },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "example": 450.2 },
              "y": { "type": "number", "example": 188.0 }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "example": { "enemy": "goomba", "consecutiveStomps": 1 }
          }
        }
      },
      "TelemetryBatch": {
        "type": "object",
        "required": ["sessionId", "playerId", "events"],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "playerId": {
            "type": "string",
            "example": "player_b2_01"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TelemetryEvent"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message", "timestamp"],
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_CHECKSUM"
          },
          "message": {
            "type": "string",
            "example": "کد اعتبارسنجی ارسالی با امتیاز تطابق ندارد."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2025-05-10T14:32:00Z"
          }
        }
      }
    }
  }
}