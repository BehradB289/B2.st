{
  "name": "@b2st/super-mario-engine",
  "version": "1.0.0",
  "description": "Modular NES Super Mario Engine with Canvas 2D and ECS Architecture",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node -e \"console.log('Production served via Docker/Nginx')\"",
