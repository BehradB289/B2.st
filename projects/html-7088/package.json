{
  "name": "mario-html5-secure-engine",
  "version": "1.4.0",
  "description": "Secure, deterministic Mario Web Game engine with hardened server environment",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "security:audit": "npm audit --audit-level=high",
    "security:check-env": "node -e 'import(\"./config/env_config.js\")'",
    "lint": "eslint . --ext .js --max-warnings=0"
  },
  "keywords": [
    "mario",
    "game",
    "canvas",
    "security-hardened",
    "b2st-studio"
  ],
  "author": "B2.st Cyber Defense Lab",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}