# ====================================================================
# VoiceProposal - استودیو B2.st
# تنظیمات متغیرهای محیطی هوش مصنوعی و پایگاه داده
# ====================================================================

# کلید دسترسی Groq Cloud (برای Whisper-large-v3 و Llama-3-70b)
# تهیه از: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# مدل زبانی استخراج ساختار حقوقی (پیش‌فرض: llama-3.3-70b-versatile یا llama-3.1-70b-versatile)
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# تنظیمات اتصال Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# کلید محرمانه ادمین Supabase جهت ثبت مطمئن در Server Actions بدون محدودیت کلاینت
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# پیکربندی پیش‌فرض استودیو و ارز
NEXT_PUBLIC_DEFAULT_STUDIO_NAME="استودیو B2.st"
NEXT_PUBLIC_DEFAULT_CURRENCY="IRT"